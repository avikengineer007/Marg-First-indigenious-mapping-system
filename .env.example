# ─────────────────────────────────────────────
# Marg — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────

# ── Server ──────────────────────────────────
MARG_HOST=0.0.0.0
MARG_PORT=8000
MARG_DEBUG=false
MARG_LOG_LEVEL=info

# ── Rate Limiting ────────────────────────────
# Requests per minute per client IP
MARG_RATE_LIMIT_RPM=60
# Burst allowance above the steady rate
MARG_RATE_LIMIT_BURST=20

# ── Routing Backends (OSRM) ──────────────────
# Leave blank to use the built-in local graph router (development only)
MARG_OSRM_FOOT_URL=http://localhost:5000
MARG_OSRM_CAR_URL=http://localhost:5001
MARG_OSRM_BIKE_URL=http://localhost:5002

# ── Geocoding Backend (Nominatim) ────────────
MARG_NOMINATIM_URL=http://localhost:8080
# User-Agent string sent with Nominatim requests (required by OSM policy)
MARG_NOMINATIM_USER_AGENT=marg-engine/0.1.0

# ── Local SQLite Geocoding Index ─────────────
MARG_GEOCODE_DB_PATH=./data/geocode.db

# ── Tile Serving ─────────────────────────────
# Path to the local PMTiles / MBTiles archive
MARG_TILES_PATH=./data/tiles/india-pilot.pmtiles
# Optional: upstream tile source URL as fallback (e.g. MapTiler free tier)
# MARG_TILE_UPSTREAM_URL=https://api.maptiler.com/tiles/v3/{z}/{x}/{y}.pbf?key=YOUR_KEY

# ── Phase 2: Telemetry Ingestion ─────────────
# Master switch — set to false to disable the /telemetry endpoint entirely
MARG_TELEMETRY_ENABLED=false
MARG_TELEMETRY_DB_PATH=./data/telemetry.db
# Salt rotation period for pseudonymized session IDs (hours)
MARG_TELEMETRY_SALT_ROTATION_HOURS=24

# ── Data Paths ───────────────────────────────
MARG_DATA_DIR=./data
MARG_OSM_EXTRACT_DIR=./data/osm

# ── Security ─────────────────────────────────
# Optional API key header (X-Marg-Key) — leave blank to disable key auth
# MARG_API_KEY=your-secret-api-key-here
# CORS allowed origins (comma-separated); * permits all
MARG_CORS_ORIGINS=*
